{
  "name": "CQNetworkPublic",
  "version": "0.3.0",
  "summary": "网络请求公共-可以解耦底层，使得底层使用任意的网络框架",
  "homepage": "https://github.com/dvlproad/CJNetwork.git",
  "license": {
    "type": "Copyright",
    "text": "              © 2008-2020 dvlproad. All rights reserved.\n"
  },
  "authors": {
    "dvlproad": ""
  },
  "description": "- Helper: 类方法\n- Client: 实例方法\n                 网络请求公共-可以解耦底层，使得底层使用任意的网络框架，可按需独立引入：\n                 • CQNetworkPublic/Base - 基础公共类\n                 • CQNetworkPublic/Request - Request 普通请求\n                 • CQNetworkPublic/Request/Base - Base\n                 • CQNetworkPublic/Request/Helper - Helper 帮助工具类方法\n                 • CQNetworkPublic/Request/Client - Client 实例类方法\n                 • CQNetworkPublic/Upload - Upload 上传请求\n                 • CQNetworkPublic/Upload/Base - Base\n                 • CQNetworkPublic/Upload/Helper - Helper 帮助工具类方法\n                 • CQNetworkPublic/Upload/Client - Client 实例类方法\n\n                 每个子库可独立引入，详见各子库描述。",
  "platforms": {
    "ios": "9.0"
  },
  "source": {
    "git": "https://github.com/dvlproad/CJNetwork.git",
    "tag": "CQNetworkPublic_0.3.0"
  },
  "frameworks": "UIKit",
  "requires_arc": true,
  "subspecs": [
    {
      "name": "Base",
      "source_files": "CQNetworkPublic/Base/**/*.{h,m}"
    },
    {
      "name": "Request",
      "subspecs": [
        {
          "name": "Base",
          "source_files": "CQNetworkPublic/Request/Base/**/*.{h,m}",
          "dependencies": {
            "CQNetworkPublic/Base": []
          }
        },
        {
          "name": "Helper",
          "source_files": "CQNetworkPublic/Request/Helper/**/*.{h,m}",
          "dependencies": {
            "CQNetworkPublic/Request/Base": []
          }
        },
        {
          "name": "Client",
          "source_files": "CQNetworkPublic/Request/Client/**/*.{h,m}",
          "dependencies": {
            "CQNetworkPublic/Request/Base": []
          }
        }
      ]
    },
    {
      "name": "Upload",
      "subspecs": [
        {
          "name": "Base",
          "source_files": "CQNetworkPublic/Upload/Base/**/*.{h,m}",
          "dependencies": {
            "CQNetworkPublic/Base": [],
            "CJNetworkFileModel": []
          }
        },
        {
          "name": "Helper",
          "source_files": "CQNetworkPublic/Upload/Helper/**/*.{h,m}",
          "dependencies": {
            "CQNetworkPublic/Upload/Base": []
          }
        },
        {
          "name": "Client",
          "source_files": "CQNetworkPublic/Upload/Client/**/*.{h,m}",
          "dependencies": {
            "CQNetworkPublic/Upload/Base": []
          }
        }
      ]
    }
  ]
}
